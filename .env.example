# FieldNote environment. Copy to .env (never commit .env). Every variable is optional:
# without keys FieldNote runs on the deterministic MockClient, skips social collectors and writes
# deliveries to out/<workspace>/outbox/ (dry run).

# --- LLM ----------------------------------------------------------------------------------------
# Any ONE key is enough. With several, FIELDNOTE_LLM=auto uses Anthropic, then Gemini, then NVIDIA,
# then Groq. Within a provider, models are tried best first. When a model is out of quota, overloaded
# or failing, the next model (then the next provider) takes over and the failed one is skipped for a
# while. Lists are comma-separated, best first; leave them unset to use the tested defaults.

# Google Gemini, free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Requests per minute FieldNote allows itself (keep at or below your free-tier limit).
GEMINI_RPM=8

# NVIDIA NIM, free tier: create a key at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
# NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# NVIDIA_FAST_MODELS=nvidia/nemotron-3-super-120b-a12b
NVIDIA_RPM=30

# Groq, free tier: create a key at https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_FAST_MODELS=openai/gpt-oss-20b
GROQ_RPM=25

# Anthropic Claude (paid API)
ANTHROPIC_API_KEY=
# Main model for research, analysis, critique and writing.
FIELDNOTE_MODEL=claude-sonnet-5
# Fast model for tagging, classification, routing and extraction.
FIELDNOTE_FAST_MODEL=claude-haiku-4-5-20251001
# auto (every provider with a key: anthropic, gemini, nvidia, groq) | mock | one provider | an explicit
# fallback chain such as gemini,nvidia,groq
FIELDNOTE_LLM=auto

# --- Dashboard access (set these when the dashboard is reachable by others) -----------------------
# Password required to open the dashboard (compared in constant time; never logged).
FIELDNOTE_DASHBOARD_PASSWORD=
# 1 = hide create/edit/run/archive controls (view-only dashboard).
FIELDNOTE_DASHBOARD_READONLY=
# 1 = allow fetching private/intranet addresses (off by default: FieldNote refuses URLs that resolve to
# private, loopback or link-local addresses, which protects hosted deployments from SSRF).
FIELDNOTE_ALLOW_PRIVATE_URLS=

# --- Storage ----------------------------------------------------------------------------------
# Default: sqlite:///data/fieldnote.db (live) and sqlite:///data/demo.db (offline/demo).
# Postgres example (pip install 'fieldnote[postgres]'): postgresql+psycopg://user:pass@host:5432/fieldnote
DATABASE_URL=

# --- Reddit (official API, read-only; create a "script" app at reddit.com/prefs/apps) ----------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FieldNoteBot/1.0 (research; contact: you@example.com)

# --- YouTube Data API v3 --------------------------------------------------------------------
YOUTUBE_API_KEY=

# --- Telegram delivery (bot token from @BotFather, chat id of the target chat) -----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email delivery (SMTP) ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients
SMTP_TO=

# --- Crawler identity -------------------------------------------------------------------------
# Shown in the User-Agent: FieldNoteBot/1.0 (+<contact>). Please set a real contact address.
FIELDNOTE_CONTACT_EMAIL=

# --- Google Sheets sync for the action tracker (optional; pip install 'fieldnote[sheets]') -------
# Path to a service-account JSON file, or the JSON itself. Share the sheet with the service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Live collection (the dashboard keeps every workspace current on its own) --------------------
# on: `fieldnote dashboard` runs the scheduler in-process. off: run `fieldnote live` as a separate worker.
FIELDNOTE_SCHEDULER=on
# Check news, competitor pages and social sources this often (minutes; each check makes few or no LLM calls)
FIELDNOTE_PULSE_MINUTES=30
# Re-run the full analysis (researcher, critic, analyst, writer) this often (hours; ~50-150 LLM calls each)
FIELDNOTE_ANALYSIS_HOURS=6
# Send the daily brief through the configured channels once a day after this hour (workspace-local time)
FIELDNOTE_DELIVER_AT_HOUR=7
# Runs allowed at once across workspaces (only one full analysis at a time, to respect free LLM rate limits)
FIELDNOTE_MAX_CONCURRENT_RUNS=2

# --- Misc -------------------------------------------------------------------------------------
# Default workspace for commands without -w
FIELDNOTE_WORKSPACE=ev_two_wheelers_india
# DEBUG | INFO | WARNING | ERROR
FIELDNOTE_LOG_LEVEL=INFO
# text | json
FIELDNOTE_LOG_FORMAT=text
# Optional directory overrides
FIELDNOTE_OUT_DIR=
FIELDNOTE_DATA_DIR=
FIELDNOTE_WORKSPACES_DIR=
FIELDNOTE_FIXTURES_DIR=
